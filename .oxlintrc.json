{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  // Type-aware Effect rules (effecttsgo/*) come from @effect/tsgo via oxlint-tsgolint.
  // `bun install` runs `effect-tsgo patch --oxlint` (see package.json "prepare") to wire them in.
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": ["typescript", "import", "oxc", "eslint", "unicorn", "node", "effecttsgo"],
  // Syntactic Effect discipline (casts, loops, let, switch, throw, Map, Object.*, ...): see lint/effect-native.ts.
  "jsPlugins": ["./lint/effect-native.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": ["**/dist", "**/coverage", "**/node_modules", ".amp/**", ".agents/**"],
  "rules": {
    // Plain JS/TS that should be Effect (lint/effect-native.ts).
    "effect-native/type-assertions": "error",
    "effect-native/no-let": "error",
    "effect-native/imperative-loops": "error",
    "effect-native/switch-statement": "error",
    "effect-native/collections": "error",
    "effect-native/object-builtins": "error",
    "effect-native/array-builtins": "error",
    "effect-native/json-builtins": "error",
    "effect-native/no-throw-try": "error",
    "effect-native/no-new-error": "error",
    "effect-native/no-async": "error",
    "effect-native/promise-chaining": "error",
    "effect-native/utility-types": "error",
    "effect-native/tacit-usage": "error",
    "effect-native/entry-point": "error",
    "effect-native/error-swallowing": "error",
    "effect-native/no-log-interpolation": "error",
    "effect-native/abort-controller": "error",
    "effect-native/error-type-annotation": "error",
    // Effect diagnostics that should fail CI rather than warn.
    "effecttsgo/floating-effect": "error",
    "effecttsgo/missing-effect-context": "error",
    "effecttsgo/missing-effect-error": "error",
    "effecttsgo/missing-layer-context": "error",
    "effecttsgo/outdated-api": "error",
    "effecttsgo/unsafe-effect-type-assertion": "error",
    // Plugins run inside Amp's Bun process; `console` output is not shown to the user. Use amp.logger / Effect.log.
    "effecttsgo/global-console": "error",
    "effecttsgo/global-console-in-effect": "error",
    "effecttsgo/process-env": "error",
    "effecttsgo/process-env-in-effect": "error",
    // Native rules tuned to match Effect's own oxlintrc (packages/tools/oxc/oxlintrc.json).
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-useless-empty-export": "error",
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "eslint/no-useless-constructor": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-useless-concat": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/no-accessor-recursion": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/no-map-spread": "off",
    "eslint/no-underscore-dangle": "off", // `_tag` discriminators are idiomatic Effect.
    "eslint/object-shorthand": "off",
    "eslint/no-shadow": "off",
    "eslint/no-unused-vars": "off",
    "eslint/require-yield": "off",
    "eslint/no-fallthrough": "off",
    "eslint/no-await-in-loop": "off",
    "unicorn/no-new-array": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-set-has": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-empty-interface": "off",
    "typescript/ban-ts-comment": "off",
    "typescript/no-namespace": "off",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-dynamic-delete": "off",
    "typescript/no-invalid-void-type": "off",
    "typescript/no-unsafe-function-type": "off",
    "typescript/unified-signatures": "off",
    "typescript/no-empty-object-type": "off",
    "typescript/no-confusing-non-null-assertion": "off",
    "typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      // Build scripts and tests run outside Amp: console, process.env, and node: imports are fine there.
      "files": ["**/scripts/**", "**/test/**", "**/*.test.ts", "packages/testing/src/**"],
      "rules": {
        "eslint/no-console": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-console-in-effect": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/process-env-in-effect": "off",
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      // Tests and the shared test support are entry points: each test provides its own layers, an assertion fails by
      // throwing, and untagged errors are injected on purpose to prove they are rendered as defects.
      "files": ["**/test/**", "**/*.test.ts", "packages/testing/src/**"],
      "rules": {
        "effect-native/no-throw-try": "off",
        "effect-native/entry-point": "off",
        "effect-native/no-log-interpolation": "off",
        "effecttsgo/strict-effect-provide": "off",
        "effecttsgo/global-error-in-effect-failure": "off"
      }
    },
    {
      // The lint plugin itself is oxlint tooling, not Effect code: it speaks ESTree and the oxlint plugin API.
      "files": ["lint/**"],
      "rules": {
        "effect-native/type-assertions": "off",
        "effect-native/no-let": "off",
        "effect-native/imperative-loops": "off",
        "effect-native/switch-statement": "off",
        "effect-native/collections": "off",
        "effect-native/object-builtins": "off",
        "effect-native/array-builtins": "off",
        "effect-native/json-builtins": "off",
        "effect-native/no-throw-try": "off",
        "effect-native/no-new-error": "off",
        "effect-native/utility-types": "off",
        "effect-native/error-swallowing": "off"
      }
    }
  ]
}
